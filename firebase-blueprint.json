{
  "entities": {
    "HubItem": {
      "title": "HubItem",
      "description": "A saved link or job posting.",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "type": { "type": "string", "enum": ["yt", "ys", "li", "lp", "job", "blog", "email", "tw", "git", "ig", "igp", "th", "lab", "web"] },
        "url": { "type": "string" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "starred": { "type": "boolean" },
        "company": { "type": "string" },
        "location": { "type": "string" },
        "role": { "type": "string" },
        "thumbnail": { "type": "string" },
        "vid": { "type": "string" },
        "date": { "type": "string" },
        "ts": { "type": "number" },
        "shortcode": { "type": "string" },
        "videoUrl": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "media": { "type": "array" }
      },
      "required": ["id", "type", "url", "title", "ts"]
    }
  },
  "firestore": {
    "/public_items/{itemId}": {
      "schema": { "$ref": "#/entities/HubItem" },
      "description": "Public saved items."
    }
  }
}
